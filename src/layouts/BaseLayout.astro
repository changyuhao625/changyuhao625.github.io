---
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    author?: string;
    tags?: string[];
  };
}

const { title, description, image, article } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
  </head>
  <body>
    <SiteHeader />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
