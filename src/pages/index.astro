---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, POSTS_PER_PAGE } from "../consts";
import { readingTime } from "../utils/reading-time";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const first = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

function excerpt(body: string) {
  const plain = body
    .replace(/```[\s\S]*?```/g, "")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[[^\]]*\]\([^\)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^\)]*\)/g, "$1")
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/[#>*_~]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  return plain.slice(0, 180) + (plain.length > 180 ? "…" : "");
}
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>Harry Chang</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  {first.map((post) => {
    const { minutes } = readingTime(post.body ?? "");
    return (
      <article class="post-preview">
        <a href={`/${post.id}/`}>
          <h2 class="post-title">{post.data.title}</h2>
          {post.data.subtitle && <h3 class="post-subtitle">{post.data.subtitle}</h3>}
          <p class="post-excerpt">{excerpt(post.body ?? "")}</p>
        </a>
        <p class="post-meta">
          <FormattedDate date={post.data.date} />
          <span class="dot"></span>
          <span>{minutes} min read</span>
          <span class="dot"></span>
          <span class="tag">{post.data.category}</span>
        </p>
      </article>
    );
  })}

  {totalPages > 1 && (
    <ul class="pager">
      <li></li>
      <li class="next"><a href="/page/2/">Older Posts &rarr;</a></li>
    </ul>
  )}
</BaseLayout>
