---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, POSTS_PER_PAGE } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const pageSize = POSTS_PER_PAGE;
const first = posts.slice(0, pageSize);
const totalPages = Math.ceil(posts.length / pageSize);

function postUrl(id: string) {
  return `/${id}/`;
}

function excerpt(body: string) {
  const plain = body
    .replace(/```[\s\S]*?```/g, "")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[[^\]]*\]\([^\)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^\)]*\)/g, "$1")
    .replace(/[#>*_~\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  return plain.slice(0, 200) + (plain.length > 200 ? "…" : "");
}
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>Harry Chang's Blog</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  {first.map((post) => (
    <article class="post-preview">
      <a href={postUrl(post.id)}>
        <h2 class="post-title">{post.data.title}</h2>
        {post.data.subtitle && <h3 class="post-subtitle">{post.data.subtitle}</h3>}
        <p class="post-excerpt">{excerpt(post.body ?? "")}</p>
      </a>
      <p class="post-meta">
        Posted by {post.data.author} on <FormattedDate date={post.data.date} />
        · <span class="tag">{post.data.category}</span>
      </p>
      <hr />
    </article>
  ))}

  {totalPages > 1 && (
    <ul class="pager">
      <li></li>
      <li class="next"><a href="/page/2/">Older Posts &rarr;</a></li>
    </ul>
  )}
</BaseLayout>
