---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import PostLayout from "../layouts/PostLayout.astro";
import { readingTime } from "../utils/reading-time";
import { extractDescription } from "../utils/description";
import { SITE_TITLE, SITE_URL } from "../consts";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { minutes, words } = readingTime(post.body ?? "");

const description = extractDescription(post.body, {
  description: post.data.description,
  subtitle: post.data.subtitle,
});

const url = `${SITE_URL}/${post.id}/`;
const image = post.data.headerImg
  ? new URL(post.data.headerImg, SITE_URL).toString()
  : `${SITE_URL}/img/avatar.harry.512.png`;

const breadcrumbParts = post.id.split("/");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description,
    image,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    inLanguage: "zh-Hant",
    wordCount: words,
    keywords: post.data.tags.join(", "),
    articleSection: post.data.category,
    author: {
      "@type": "Person",
      name: post.data.author,
      url: `${SITE_URL}/about/`,
    },
    publisher: {
      "@type": "Person",
      name: "Harry Chang",
      url: SITE_URL,
      logo: {
        "@type": "ImageObject",
        url: `${SITE_URL}/img/avatar.harry.512.png`,
      },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: breadcrumbParts[0],
        item: `${SITE_URL}/archive/`,
      },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<PostLayout
  title={post.data.title}
  subtitle={post.data.subtitle}
  date={post.data.date}
  tags={post.data.tags}
  category={post.data.category}
  author={post.data.author}
  slug={post.id}
  description={description}
  headerImg={post.data.headerImg}
  readingMinutes={minutes}
  headings={headings}
  jsonLd={jsonLd}
>
  <Content />
</PostLayout>
